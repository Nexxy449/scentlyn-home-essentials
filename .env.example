# Public browser configuration only. Do not place service-role or secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key

# Server-only payment configuration. Set these in Vercel/server environment variables.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
PAYSTACK_SECRET_KEY=sk_test_or_live_replace_me
APP_URL=https://your-production-domain.example
